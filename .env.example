# Generate distinct private credentials with: python scripts/init_env.py
SENTINEL_OPERATOR_TOKEN=
SENTINEL_APPROVER_TOKEN=
SENTINEL_DB=sentinel.db
SENTINEL_MODEL_PATH=
SENTINEL_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000,http://127.0.0.1:8000

# Optional pinned third-party baseline, after downloading it:
SENTINEL_HF_MODEL_PATH=
SENTINEL_TORCH_THREADS=2
